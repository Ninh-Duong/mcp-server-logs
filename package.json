{
  "name": "mcp-server-logs",
  "version": "1.0.0",
  "description": "Unified MCP server for Seq and OpenObserve log search",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-server-logs": "./cli.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test --import ./dist/tests/env.js --experimental-test-coverage --test-coverage-exclude=\"dist/tests/**\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 dist/tests/*.test.js",
    "start": "node start.mjs",
    "cli": "node start.mjs --cli",
    "preflight": "node start.mjs --preflight",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "logging",
    "observability",
    "seq",
    "openobserve"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "cli.mjs",
    "npm-shrinkwrap.json",
    "dist",
    "!dist/tests",
    "config/*.example"
  ]
}
